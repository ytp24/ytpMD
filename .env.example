# ==============================================================================
# ytpMD [pdf2md] — Environment Configuration & Secrets Template
# ==============================================================================
# Copy this file to .env and populate your actual values.
# NEVER commit the active .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE STORAGE & CDN DISTRIBUTION (Binary Storage & Release Artifacts)
# ------------------------------------------------------------------------------
# Where to obtain:
# 1. Sign in to https://supabase.com/dashboard -> Select/Create Project
# 2. Go to Project Settings -> API:
#    - Project URL      -> SUPABASE_URL
#    - anon public      -> SUPABASE_ANON_KEY
#    - service_role     -> SUPABASE_SERVICE_ROLE_KEY (Keep secret! Used in CI/CD)
# 3. Go to Storage -> Create a new Public Bucket named 'releases' (or custom name)
# ------------------------------------------------------------------------------

# Project API URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"

# Public anon key (Used for public download queries / client-side lookups)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Service Role Key (Required by CI/CD to upload release binaries to storage)
# GitHub Secret Name: SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# Target Storage Bucket name for binary files (Default: "releases")
SUPABASE_BUCKET="releases"


# ------------------------------------------------------------------------------
# 2. FIREBASE HOSTING & WEB APP CONFIGURATION
# ------------------------------------------------------------------------------
# Where to obtain:
# 1. Sign in to https://console.firebase.google.com -> Select/Create Project
# 2. Go to Project Settings -> General -> "Your apps" -> Web App (</>):
#    - apiKey, authDomain, projectId, storageBucket, messagingSenderId, appId
# 3. For Automated GitHub Actions Deployment:
#    - In Google Cloud Console / Firebase Console -> Service Accounts -> Create Key (JSON)
#    - Copy JSON content into GitHub Secret: FIREBASE_SERVICE_ACCOUNT_YTPMD
# ------------------------------------------------------------------------------

# Firebase Project ID (Matches .firebaserc and firebase.json)
FIREBASE_PROJECT_ID="ytpmd-app"

# Web Client API Key
FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere12345678"

# Firebase Auth Domain
FIREBASE_AUTH_DOMAIN="ytpmd-app.firebaseapp.com"

# Firebase Cloud Storage Bucket (for web assets)
FIREBASE_STORAGE_BUCKET="ytpmd-app.appspot.com"

# Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID="123456789012"

# Firebase Web App ID
FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890abcdef"

# Firebase CLI Deploy Token (Alternative to service account for manual 'firebase deploy')
FIREBASE_TOKEN=""


# ------------------------------------------------------------------------------
# 3. GITHUB ACTIONS SECRETS REFERENCE
# ------------------------------------------------------------------------------
# Add these in GitHub: Repository -> Settings -> Secrets and variables -> Actions
#
# Secret Name                       | Purpose
# ----------------------------------|-------------------------------------------
# SUPABASE_URL                      | Supabase project API endpoint
# SUPABASE_SERVICE_ROLE_KEY         | Secret key for automated binary uploads
# SUPABASE_BUCKET                   | Storage bucket name (e.g. releases)
# FIREBASE_SERVICE_ACCOUNT_YTPMD    | Full Service Account JSON for web deploy
# ------------------------------------------------------------------------------
