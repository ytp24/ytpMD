# Supabase Public CDN Endpoint & Anon Key (for fetching release links/stats)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"
VITE_SUPABASE_BUCKET="releases"

# Firebase Public Web Configuration
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere12345678"
VITE_FIREBASE_AUTH_DOMAIN="ytpmd-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="ytpmd-app"
VITE_FIREBASE_STORAGE_BUCKET="ytpmd-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890abcdef"
